# ========================================================
# Antigravity Telegram Bot Bridge Configuration
# ========================================================

# 1. Telegram Bot Token (obtain from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# 2. Security: Authorized Telegram User IDs (comma-separated).
# Obtain your ID from @userinfobot on Telegram.
# If empty, ANY user who messages the bot can execute commands on your machine!
ALLOWED_USERS=""

# 3. Default Model Tier for new conversations: flash_lite | flash | pro
DEFAULT_MODEL="flash"

# 4. Default Local Workspace (defaults to this project directory if empty)
DEFAULT_WORKSPACE=""

# 5. Path to agentapi binary (optional, auto-discovered if not specified)
# AGENTAPI_PATH="/Users/evasi0nxiao/.gemini/antigravity/bin/agentapi"

# 6. Antigravity Language Server address & token (optional, auto-discovered from running process)
# ANTIGRAVITY_LS_ADDRESS="127.0.0.1:59242"
# ANTIGRAVITY_CSRF_TOKEN=""
